{
  "title": "SCL project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["iomrVersion", "modelLocation", "upgradeEligibility"],
  "properties": {
    "iomrVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "modelLocation": {"type": "string", "minLength": 1},
    "upgradeEligibility": {"type": "string", "minLength": 1},
    "role": {"type": "string", "enum": ["development", "solution-test"]}
  }
}
